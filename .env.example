EMAIL_ADDRESS=owner@example.com
EMAIL_PASSWORD=replace-with-provider-app-password
IMAP_HOST=imap.example.com
IMAP_PORT=993
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_STARTTLS=false
DRAFTS_MAILBOX=Drafts
TRASH_MAILBOX=Trash
# Optional exact IMAP mailbox name for standard cross-mailbox conversation reads.
# ARCHIVE_MAILBOX=Archive
# Optional administrator-selected persistent metadata cache configuration.
# CACHE_CONFIG_PATH=/data/cache.json
MAIL_MODE=read
MCP_RESOURCE=https://mail.example.com/email/mcp
OIDC_ISSUER=https://mail.example.com/auth/v1/
OIDC_AUDIENCE=https://mail.example.com/email/mcp
OIDC_SUBJECTS=replace-with-authorized-user-subject-id
OIDC_SCOPE=email:mcp
BIND=127.0.0.1:18590
DATABASE_PATH=data/operations.sqlite
# Optional private attachment staging directory; defaults to mail-downloads beside DATABASE_PATH.
# Set explicitly when DATABASE_PATH=:memory: and HTTP attachment downloads are needed.
# ATTACHMENT_STAGING_DIR=data/mail-downloads
# Optional; defaults to accounts.sqlite beside DATABASE_PATH.
# ACCOUNT_REGISTRY_PATH=data/accounts.sqlite
# Optional multi-account JSON; omit to retain the original single-account setup.
# ACCOUNT_CONFIG_PATH=secrets/accounts.json
# Root for relative password file references in that JSON.
# MAIL_SECRET_ROOT=secrets/mail-credentials
