# Include inside your HTTPS server block; use your own TLS certificate configuration.
# Keep static resources independent from any login limits added to /auth/.
location ^~ /auth/v1/_app/ {
    proxy_pass http://127.0.0.1:19556;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    access_log off;
}
location ^~ /auth/v1/assets/ {
    proxy_pass http://127.0.0.1:19556;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    access_log off;
}
location ^~ /auth/v1/theme/ {
    proxy_pass http://127.0.0.1:19556;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    access_log off;
}
location ^~ /auth/ {
    proxy_pass http://127.0.0.1:19556;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    access_log off;
}
location ^~ /email/ {
    proxy_pass http://127.0.0.1:19580/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 120s;
    client_max_body_size 256k;
    access_log off;
}
location = /.well-known/oauth-protected-resource/email/mcp {
    proxy_pass http://127.0.0.1:19580/.well-known/oauth-protected-resource;
    proxy_set_header Host $host;
    access_log off;
}
